# Dabcam + MetasploitMCP Environment Configuration
# Copy this file to .env and update values for your environment

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Database Configuration
DB_PASSWORD=changeme123
DATABASE_URL=postgresql://dabcam_user:changeme123@postgres:5432/dabcam

# Redis Configuration
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@redis:6379/0

# Metasploit RPC Configuration
MSF_RPC_HOST=metasploit
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=changeme123

# pgAdmin Configuration
PGADMIN_PASSWORD=admin123

# ngrok Configuration (for public tunneling)
NGROK_AUTHTOKEN=your_ngrok_token_here
NGROK_REGION=us

# Serveo Configuration (SSH tunneling, no account needed)
USE_SERVEO=false

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8001
REACT_APP_MSF_API_URL=http://localhost:8002

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,dabcam.local

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_STORAGE=10737418240

# Storage Paths
STORAGE_DIR=/secure/storage
BINARIES_DIR=/secure/binaries

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE=/var/log/dabcam/app.log

# Debug Mode
DEBUG=false
TESTING=false
